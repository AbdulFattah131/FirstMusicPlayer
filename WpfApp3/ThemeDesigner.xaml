<Window x:Class="MusicPlayer.UIComponents.ThemeDesigner"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theme Designer"
        Height="800" Width="420"
        Background="#E7EAF0"
        WindowStartupLocation="CenterScreen">

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Theme Designer" FontSize="17" FontWeight="Black" Foreground="#393b40"></TextBlock>
           
            <!-- Title Row -->
            <DockPanel Grid.Row="1">
                <ComboBox Name="cbThemes"
                      ItemsSource="{Binding Path=LoadedThemes}"
                      DisplayMemberPath="Name"
                      Width="220"
                      Height="28"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"/>
                <Button Name="btnLoad"
                    Content="Load"
                    Width="80"
                    Height="28"
                    Background="#393b40"
                    Foreground="White"
                    BorderThickness="0"
                    />
            </DockPanel>

            <!-- Fields -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical">
                    <!-- Generic field template -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Theme Name" FontWeight="Bold" Margin="0,10,20,4"/>
                        <TextBox Name="itbName"
                             Text="{Binding Path=CustomTheme.Name, UpdateSourceTrigger=PropertyChanged}"
                             Height="32" Width="200"
                             Padding="6,2"
                             BorderThickness="0"
                             Background="White"
                             />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Window Accent" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DockPanel>
                            <TextBox Name="itbWindowAccentHex"
                                 Width="120" Height="32"
                                 Padding="6,2"
                                 BorderThickness="0"
                                 Background="White"
                                
                                 TextChanged="TextBox_TextChanged"/>
                            <Rectangle Width="28" Height="28"
                                   Margin="8,2,0,0"
                                   Stroke="#CCC"
                                   RadiusX="6" RadiusY="6"
                                   Fill="{Binding Path=CustomTheme.WindowAccent.Brush}"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Repeat same block for WindowContentBackground, TitleForeground, etc. -->
                    <!-- Example: -->
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Music Control Background" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DockPanel>
                            <TextBox Name="itbMusicControlBackgroundHex"
                                 Width="120" Height="32"
                                 Padding="6,2"
                                 BorderThickness="0"
                                 Background="White"
                               
                                 TextChanged="TextBox_TextChanged"/>
                            <Rectangle Width="28" Height="28"
                                   Margin="8,2,0,0"
                                   Stroke="#CCC"
                                   RadiusX="6" RadiusY="6"
                                   Fill="{Binding Path=CustomTheme.MusicControlBackground.Brush}"/>
                        </DockPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <!-- Buttons -->
            <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                >
                <Button Name="btnSave"
                    Content="Save"
                    Width="100" Height="32"
                    Background="#DBD9EA"
                    Foreground="Black"
                    BorderThickness="0"
                   />
                <Button Name="btnApply"
                    Content="Apply"
                    Width="100" Height="32"
                    Background="#393b40"
                    Foreground="White"
                    BorderThickness="0"
                    />
            </StackPanel>
        </Grid>
    </Window>

