            <UserControl x:Name="ucSongsView" Grid.Column="1">
                <!-- Songs View -->

                <Border x:Name="bdSongs" CornerRadius="13" Background="{Binding CurrentTheme.PlayerControlBackground.Brush}" Margin="10, 10, 10, 15">
                    <Border.Effect>
                        <DropShadowEffect Color="{Binding CurrentTheme.ComplementGray.Brush}"
                          Direction="270"
                          ShadowDepth="4"
                          Opacity="0.18"
                          BlurRadius="8"/>
                    </Border.Effect>
                    <Grid x:Name="grdSongsViewMain">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"></RowDefinition>
                            <RowDefinition Height="*"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>

                        <!-- SearchBox-->
                        <!--<Border x:Name="SearchBoxSongsView" Height="40" CornerRadius="13" Background="{Binding CurrentTheme.SearchBoxBackground.Brush}" Grid.Row="0" Margin="40, 30, 0, 30" Grid.Column="0" Width="250" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="20, 10, 10, 10" VerticalAlignment="Center">
                                <Path x:Name="pSongsView" Width="15" Height="15" Stretch="Uniform"
                                      Fill="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}"
                                      Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"></Path>      
                                <TextBox x:Name="tbSongsView" Text="Search" FontSize="13" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}" Margin="5, 0, 0, 0" VerticalAlignment="Center" Background="Transparent" BorderBrush="Transparent"></TextBox>
                            </StackPanel>
                        </Border>-->

                        <!-- Grid Songs View -->
                        
                        <Grid x:Name="grdSongsView" Grid.Row="1" Grid.ColumnSpan="2" Margin="40, 5, 40, 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"></RowDefinition>
                                <RowDefinition Height="*"></RowDefinition>
                            </Grid.RowDefinitions>

                            <!-- Heading -->

                            <TextBlock x:Name="tbSongViewHeading" Grid.Row="0" Text="Songs" FontFamily="Bahnschrift" FontSize="18" FontWeight="Black" Foreground="{Binding CurrentTheme.WindowHeadingForeground.Brush}" HorizontalAlignment="Left"/>

                            <!-- SongsListBox1 -->

                            <TextBlock x:Name="tbSongsList" Text="All Songs" FontSize="16.5" FontStyle="Italic" FontWeight="Black" Margin="0, 45, 0, 20" Foreground="{Binding CurrentTheme.WindowHeadingForeground.Brush}"></TextBlock>

                                <Grid x:Name="grdSongs" Grid.Row="1" Grid.Column="0" Margin="40, 20, 40, 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"></ColumnDefinition>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"></RowDefinition>
                                    </Grid.RowDefinitions>

                                        <ListBox x:Name="lbAllSongsList" ItemsSource="{Binding MusicPlayerCache.AllSongs}" SelectedItem="{Binding MusicPlayerCache.CurrentSong, Mode=TwoWay}"
                                         Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Visible" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="20, 13, 0, 13">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                            <ColumnDefinition Width="*"></ColumnDefinition>
                                                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                                                        </Grid.ColumnDefinitions>

                                                        <ContentControl x:Name="ccTrackPosition" Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                            <Setter Property="Content" Value="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}, Converter={StaticResource IndexConvertor}}"/>
                                                                    <Setter Property="Foreground" Value="{Binding DataContext.CurrentTheme.ComplementGray.Brush, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                            <Setter Property="ContentTemplate">
                                                                                <Setter.Value>
                                                                                    <DataTemplate>
                                                                                                <Path Data="M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M10,16.5L16,12L10,7.5V16.5Z"
                                                                                                      Fill="{Binding DataContext.CurrentTheme.NowPlayingForeground.Brush, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                                                      Stretch="Uniform" Width="15" Height="15"/>    
                                                                                    </DataTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                        </ContentControl>

                                                        <StackPanel x:Name="spTitleandArtist" Grid.Column="1" Margin="15, 0, 15, 0" Orientation="Vertical">
                                                            <TextBlock x:Name="tbTrackTitle" Text="{Binding Title}" FontWeight="Bold" FontSize="14" Foreground="{Binding DataContext.CurrentTheme.WindowHeadingForeground.Brush, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                                            <TextBlock x:Name="tbArtistNames" Text="{Binding Artist}" Foreground="{Binding DataContext.CurrentTheme.CurrentSongArtistForeground.Brush, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                                        </StackPanel>

                                                <TextBlock Grid.Column="2" Text="{Binding Album.Title}" VerticalAlignment="Center" Foreground="{Binding DataContext.CurrentTheme.CurrentSongArtistForeground.Brush, RelativeSource={RelativeSource AncestorType=ListBox}}"></TextBlock>
                                                        
                                                        <TextBlock x:Name="tbTrackLength" Grid.Column="3" Margin="0, 0, 0, 0" VerticalAlignment="Center" Text="{Binding Length, Converter={StaticResource DurationDisplayConverter}}" HorizontalAlignment="Center" FontWeight="Regular" FontSize="14" Foreground="{Binding DataContext.CurrentTheme.WindowHeadingForeground.Brush, RelativeSource={RelativeSource AncestorType=ListBox}}"/>

                                                        <Button x:Name="bTrackDetails" Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderBrush="Transparent" Margin="0, 0, 30, 0">
                                                            <Path Data="M16,12A2,2 0 0,1 18,10A2,2 0 0,1 20,12A2,2 0 0,1 18,14A2,2 0 0,1 16,12M10,12A2,2 0 0,1 12,10A2,2 0 0,1 14,12A2,2 0 0,1 12,14A2,2 0 0,1 10,12M4,12A2,2 0 0,1 6,10A2,2 0 0,1 8,12A2,2 0 0,1 6,14A2,2 0 0,1 4,12Z"
                                                                     Fill="{Binding DataContext.CurrentTheme.ComplementGray.Brush, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                     Stretch="Uniform" Width="10" Height="10"></Path>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                                
                                            </ListBox.ItemTemplate>

                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="5"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="border"
                                                                            Background="{TemplateBinding Background}"
                                                                            CornerRadius="11">
                                                                    <ContentPresenter />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <!-- Hover -->
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Cursor" Value="Hand"/>
                                                                        <Setter TargetName="border"
                                                                            Property="Background"
                                                                            Value="{Binding DataContext.CurrentTheme.ListBoxHover.Brush,
                                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                                                    </Trigger>
                                                                    <!-- Selected -->
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="border"
                                                                        Property="Background"
                                                                        Value="{Binding DataContext.CurrentTheme.ListBoxSelected.Brush,
                                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>

                                            <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <Border Background="Transparent" CornerRadius="10">
                                                <ScrollViewer x:Name="ScrollViewer"
                                                                VerticalScrollBarVisibility="Visible"
                                                                HorizontalScrollBarVisibility="Disabled"
                                                                Focusable="False">

                                                    <ScrollViewer.Resources>
                                                        <Style TargetType="ScrollBar">
                                                            <Setter Property="Width" Value="8"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ScrollBar">
                                                                        <Grid x:Name="Root" Background="Transparent" Width="8">
                                                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                                                <Track.DecreaseRepeatButton>
                                                                                    <RepeatButton Command="ScrollBar.LineUpCommand"
                                                                                                        Height="10"
                                                                                                        Visibility="Hidden"
                                                                                                        Background="Transparent"
                                                                                                        Focusable="False"
                                                                                                        BorderThickness="0"/>
                                                                                </Track.DecreaseRepeatButton>

                                                                                <!-- Hidden by default -->
                                                                                <Track.Thumb>
                                                                                    <Thumb x:Name="Thumb" Visibility="Collapsed">
                                                                                        <Thumb.Template>
                                                                                            <ControlTemplate TargetType="Thumb">
                                                                                                <Border Background="#c0c0c0"
                                                                                                          CornerRadius="4"
                                                                                                          SnapsToDevicePixels="True"/>
                                                                                            </ControlTemplate>
                                                                                        </Thumb.Template>
                                                                                    </Thumb>
                                                                                </Track.Thumb>

                                                                                <Track.IncreaseRepeatButton>
                                                                                    <RepeatButton Command="ScrollBar.LineDownCommand"
                                                                                                    Height="10"
                                                                                                    Visibility="Hidden"
                                                                                                    Background="Transparent"
                                                                                                    Focusable="False"
                                                                                                    BorderThickness="0"/>
                                                                                </Track.IncreaseRepeatButton>
                                                                            </Track>
                                                                        </Grid>

                                                                        <!-- Hover behavior -->
                                                                        <ControlTemplate.Triggers>

                                                                            <!-- 1️⃣ Hovering scrollbar itself -->
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
                                                                            </Trigger>

                                                                            <!-- 2️⃣ Hovering scrollbar track -->
                                                                            <Trigger SourceName="PART_Track" Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
                                                                            </Trigger>

                                                                            <!-- 3️⃣ Hovering the parent ListBox -->
                                                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                                                                                <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>


                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ScrollViewer.Resources>

                                                    <ItemsPresenter />
                                                </ScrollViewer>
                                            </Border>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                            
                                        </ListBox>
                                    </Grid>
                                </Grid>
                        </Grid>
                </Border>
                
                <UserControl.Style>
                    <Style TargetType="UserControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=btnToggleSongs}" Value="True">
                                <Setter Property="Visibility" Value="Visible"></Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=btnToggleSongs}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"></Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UserControl.Style>
            </UserControl>
            
        </Grid>

        <!-- Row 2 BottomBar -->
        
        <Border x:Name="bdrPlaybackPanel" Grid.Row="2" Grid.ColumnSpan="3" VerticalAlignment="Bottom">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                 Direction="270"
                 ShadowDepth="5"
                 Opacity="0.18"
                 BlurRadius="8"/>
            </Border.Effect>

        <!-- Row 2 MusicControl -->

        <Grid x:Name="grdMusicControl">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="120"></RowDefinition>
            </Grid.RowDefinitions>
            
            <!-- Main Container for Music Control Bar-->
            
            <Border x:Name="MusicControlBar" 
                Background="{Binding CurrentTheme.PlayerControlBackground.Brush}"
                CornerRadius="13"
                Margin="30, 0, 30, 25"
                Grid.Column="0"    
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                <!-- MusicControl -->

                <Grid x:Name="MusicControl" VerticalAlignment="Center">
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Left Side Current Song View -->

                    <Grid x:Name="grdCurrentSongView" Grid.Column="0" Grid.RowSpan="2" Margin="10, 0, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Image Width="40" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20, 0, 0, 0" Grid.Column="0" Source="{Binding MusicPlayerCache.CurrentSong.Image}"></Image>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Grid.Column="1" Margin="13, 0, 0, 0">
                            <TextBlock FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{Binding MusicPlayerCache.CurrentSong.Title}" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"></TextBlock>
                            <TextBlock Foreground="{Binding CurrentTheme.ComplementGray.Brush}" Text="{Binding MusicPlayerCache.CurrentSong.Artist}"></TextBlock>
                        </StackPanel>
                    </Grid>
                    
                    <!-- PlaybackControls (main one) -->
                    
                    <Grid x:Name="grdPlaybackControls" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" Height="42">
                        <Viewbox Stretch="Uniform">
                            <Grid x:Name="grdPlayback">
                                
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                    <Button x:Name="tbRepeat" Click="tbRepeat_Click" Grid.Row="0" Grid.Column="0"  Background="Transparent" BorderBrush="Transparent" Width="40" Margin="0, 0, 30, 0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                                <!-- 0 Repeat Default (Off) -->
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                                <Viewbox Width="32" Height="32">
                                                                    <Path x:Name="pRepeatOff"
                                                                              Data ="M17,17H7V14L3,18L7,22V19H19V13H17M7,7H17V10L21,6L17,2V5H5V11H7V7Z"
                                                                              Fill="{Binding DataContext.CurrentTheme.ComplementGray.Brush, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                              Stretch="Uniform"
                                                                              Stroke="{Binding DataContext.CurrentTheme.ComplementGray.Brush, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                              StrokeThickness="1.5"/>
                                                                </Viewbox>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    
                                                    <!-- 1 Repeat List -->
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <Viewbox Width="32" Height="32">
                                                                        <Path x:Name="pRepeatSong"
                                                                              Data ="M17,17H7V14L3,18L7,22V19H19V13H17M7,7H17V10L21,6L17,2V5H5V11H7V7Z"
                                                                              Fill="{Binding DataContext.CurrentTheme.WindowPrimaryAnchor.Brush, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                              Stretch="Uniform"
                                                                              Stroke="{Binding DataContext.CurrentTheme.WindowPrimaryAnchor.Brush, RelativeSource={RelativeSource AncestorType=Button}}"
                                                                              StrokeThickness="1.5"/>
                                                                    </Viewbox>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>

                                                     <!--2 Repeat Song--> 
                                                    <!--<Trigger Property="IsChecked" Value="{x:Null}">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <Viewbox Width="32" Height="32">
                                                                        <Path x:Name="pRepeatSong" Data="M17,17H7V14L3,18L7,22V19H19V13H17M11,9H13V15H11V9Z"
                                                                      Fill="#1e1e1e"
                                                                      Stretch="Uniform"
                                                                      Stroke="#1e1e1e"
                                                                      StrokeThickness="1.5"/>
                                                                    </Viewbox>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>-->
                                                </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                    <Button x:Name="tbPrevious" Click="tbPrevious_Click" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1" Width="60" Background="Transparent" BorderBrush="Transparent">
                                    <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <!-- Previous Default -->
                                                            <Path x:Name="Previous" Data="M6,6H8V18H6M9.5,12L18,18V6M16,14.14L12.97,12L16,9.86V14.14Z"
                                                               Fill="{Binding DataContext.CurrentTheme.ComplementGray.Brush, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Stretch="Uniform" Width="34" Height="34"/>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            
                                            <Style.Triggers>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                    <Path x:Name="Previous" Data="M6,6H8V18H6M9.5,12L18,18V6M16,14.14L12.97,12L16,9.86V14.14Z"
                                                                       Fill="#1e1e1e"
                                                                       Stretch="Uniform" Width="34" Height="34"/>
                                                                </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                            </Style>
                                    </Button.Style>
                                </Button>

                                    <ToggleButton x:Name="tbPlayPause" IsChecked="{Binding MusicPlayerCache.IsPlaying}" Grid.Row="0" Grid.Column="2" 
                                  Background="Transparent" BorderBrush="Transparent">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <!-- Play icon -->
                                                            <Path x:Name="Play" Data="M10,16.5V7.5L16,12M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                                                  Fill="{Binding DataContext.CurrentTheme.PlayPauseBackground.Brush, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                  Stretch="Uniform" Width="60" Height="60"
                                                                  ></Path>
                                                        </DataTemplate>
                                                </Setter.Value>
                                            </Setter>

                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="ContentTemplate">
                                                        <Setter.Value>
                                                            <DataTemplate>
                                                                <!-- Pause icon -->
                                                                        <Path x:Name="Pause" Data="M15,16H13V8H15M11,16H9V8H11M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                                                              Fill="{Binding DataContext.CurrentTheme.PlayPauseBackground.Brush, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                                                                              Stretch="Uniform" Width="60" Height="60"
                                                                              />
                                                                </DataTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <!-- Pause icon -->
                                                                    <Path x:Name="Pause" Data="M15,16H13V8H15M11,16H9V8H11M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                                                                       Fill="#6d6d6d"
                                                                       Stretch="Uniform" Width="60" Height="60"/>   
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>

                                    <Button x:Name="tbNext" Grid.Row="0" Click="tbNext_Click" Grid.Column="3" VerticalAlignment="Center" Width="60" Background="Transparent" BorderBrush="Transparent">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <!-- Next Default -->
                                                            <Path x:Name="Next"
                                                                  Data="M6,18L14.5,12L6,6M8,9.86L11.03,12L8,14.14M16,6H18V18H16"
                                                                  Stretch="Uniform"
                                                                  Width="34" Height="34">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Fill"
                                                                        Value="{Binding DataContext.CurrentTheme.ComplementGray.Brush,
                                                                        RelativeSource={RelativeSource AncestorType=Button}}"/>   
                                                                        <Style.Triggers>
                                                                            <!-- When pressed -->
                                                                            <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                                <Setter Property="Fill"
                                                                                Value="#1e1e1e"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Button x:Name="tbShuffle" Grid.Row="0" Click="tbShuffle_Click" Grid.Column="4" Background="Transparent" BorderBrush="Transparent" Width="40" Margin="30, 0, 0, 0">
                                    <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            
                                                            <!-- Shuffle Default-->
                                                            <Path x:Name="pShuffleEnabled" Data="M17,3L22.25,7.5L17,12L22.25,16.5L17,21V18H14.26L11.44,15.18L13.56,13.06L15.5,15H17V12L17,9H15.5L6.5,18H2V15H5.26L14.26,6H17V3M2,6H6.5L9.32,8.82L7.2,10.94L5.26,9H2V6Z"
                                                              Stretch="Uniform" Width="32" Height="32">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Fill"
                                                                         Value="{Binding DataContext.CurrentTheme.ComplementGray.Brush, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                        <Style.Triggers>
                                                                            <!-- When checked -->
                                                                            <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                                                <Setter Property="Fill" Value="{Binding DataContext.CurrentTheme.WindowPrimaryAnchor.Brush, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                            
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Viewbox>
                    </Grid>
                    
                    <!-- Right Side Controls -->
                    
                    <StackPanel x:Name="spRightSideMusicControl" Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                        
                        <!-- Volume Control -->
                            <ToggleButton x:Name="btnVolume" FontSize="16" VerticalContentAlignment="Center" OverridesDefaultStyle="True" HorizontalContentAlignment="Center" Focusable="False" Margin="0, 0, 8, 0" Background="Transparent" BorderBrush="Transparent" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}" IsChecked="{Binding MusicPlayerCache.Player.IsMuted, Mode=TwoWay}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <ContentPresenter 
                                                        HorizontalAlignment="Center" 
                                                        VerticalAlignment="Center"/>
                                                    <ControlTemplate.Triggers>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="🔇"></Setter>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter Property="Content" Value="📢"></Setter>
                                            </Trigger>
                                            

                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                        </ToggleButton>
                        
                            <Slider x:Name="sdrVolumeSlider" Minimum="0" Maximum="1" Value="{Binding MusicPlayerCache.Player.SystemVolume}" Width="60" Margin="0, 0, 10, 0">

                            <Slider.Resources>
                                <!-- Style -->
                                    <Style TargetType="RepeatButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="2" 
                                                    SnapsToDevicePixels="True"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="Thumb">
                                    <Setter Property="Width" Value="16"/>
                                    <Setter Property="Height" Value="16"/>
                                    <Setter Property="Opacity" Value="100"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Slider.Resources>

                            <Slider.Template>
                                <ControlTemplate TargetType="Slider">

                                    <!-- Root container -->
                                    <Grid>

                                        <!-- Track (main bar) -->
                                        <Track x:Name="PART_Track">

                                            <!-- Left/Decrease button -->
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="Slider.DecreaseLarge"
                                                  Background="{Binding CurrentTheme.WindowPrimarySlider.Brush}"
                                                  BorderBrush="Gray"
                                                  BorderThickness="0"
                                                  Height="5"></RepeatButton>
                                            </Track.DecreaseRepeatButton>

                                            <!-- Thumb -->
                                            <Track.Thumb>
                                                <Thumb x:Name="Thumb"
                                                   Width="12" Height="12"
                                                   Background="{Binding CurrentTheme.WindowTextForeground.Brush}"
                                                   BorderBrush="#494454"
                                                   BorderThickness="0"/>
                                            </Track.Thumb>

                                            <!-- Right/Increase button -->
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="Slider.IncreaseLarge"
                                                  Background="#C5C5C5"
                                                  BorderBrush="Gray"
                                                  BorderThickness="0"
                                                  Height="5"/>
                                            </Track.IncreaseRepeatButton>

                                        </Track>

                                    </Grid>

                                    <!-- TRIGGERS -->
                                    <ControlTemplate.Triggers>

                                        <!-- Hover on Thumb -->
                                        <Trigger SourceName="Thumb" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
                                            <Setter TargetName="Thumb" Property="Background" Value="Gray"/>
                                        </Trigger>

                                        <!-- Thumb pressed -->
                                        <Trigger SourceName="Thumb" Property="IsDragging" Value="True">
                                            <Setter TargetName="Thumb" Property="Background" Value="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}"/>
                                        </Trigger>

                                        <!-- Disabled Slider -->
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="PART_Track" Property="Opacity" Value="0.5"/>
                                            <Setter TargetName="Thumb" Property="Opacity" Value="0.5"/>
                                        </Trigger>

                                        <!-- Orientation (vertical) -->
                                        <Trigger Property="Orientation" Value="Vertical">
                                        </Trigger>

                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Slider.Template>
                        </Slider>

                        <!-- Theme Switch -->
                            <ToggleButton x:Name="tbSwitchTheme" Margin="0, 0, 20, 0" Visibility="Visible" Click="SwitchButton_Click" Width="30" Height="20" Background="Transparent" BorderBrush="Transparent">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="TemplateRoot"
                                        CornerRadius="5"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Border x:Name="Track"
                                                CornerRadius="6"
                                                Background="LightGray"
                                                Margin="2" />
                                                <Border x:Name="Thumb"
                                                CornerRadius="7"
                                                Background="White"
                                                Width="12" Height="12"
                                                HorizontalAlignment="Left"
                                                Margin="2" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Track" Property="Background" Value="{Binding DataContext.CurrentTheme.WindowPrimaryAnchor.Brush, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
                                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TemplateRoot" Property="BorderBrush" Value="DarkGray" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="TemplateRoot" Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                    </StackPanel>

                    <!-- PlaybackSeekbar (main one) -->

                    <StackPanel Grid.Row="1" Grid.Column="1" x:Name="MainSlider" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock x:Name="tbTrackStart" Margin="0, 0, 10, 0" VerticalAlignment="Bottom" HorizontalAlignment="Left" Text="{Binding MusicPlayerCache.CurrentPosition, Converter={StaticResource DurationDisplayConverter}}" FontWeight="Regular" FontSize="11.3" Foreground="{Binding CurrentTheme.WindowHeadingForeground.Brush}"/>

                            <Slider x:Name="sdrMusicPlayerSeekBar" Width="400" Minimum="0" Maximum="{Binding MusicPlayerCache.CurrentSong.Length}" Value="{Binding MusicPlayerCache.CurrentPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewMouseDown="sdrMusicPlayerSeekBar_PreviewMouseDown" PreviewMouseUp="sdrMusicPlayerSeekBar_PreviewMouseUp" Margin="0, 10, 0, 0">
                        
                        <Slider.Resources>
                            
                            <!-- Style -->
                            
                                <Style TargetType="RepeatButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border x:Name="btnRepeat" Background="{TemplateBinding Background}"
                                                CornerRadius="2" 
                                                SnapsToDevicePixels="True"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            
                            <Style TargetType="Thumb">
                                <Setter Property="Width" Value="16"/>
                                <Setter Property="Height" Value="16"/>
                                    <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{TemplateBinding Background}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            
                        </Slider.Resources>

                        <Slider.Template>
                            
                            <ControlTemplate TargetType="Slider">

                                <!-- Root container -->
                                <Grid>
                                    
                                    <!-- Track (main bar) -->
                                    <Track x:Name="PART_Track">

                                        <!-- Left/Decrease button -->
                                        <Track.DecreaseRepeatButton>
                                                <RepeatButton x:Name="DecreaseRepeatButton" Command="Slider.DecreaseLarge"
                                                      Background="{Binding CurrentTheme.WindowPrimarySlider.Brush}"
                                                      BorderBrush="Gray"
                                                      BorderThickness="0"
                                                      Height="5"></RepeatButton>
                                        </Track.DecreaseRepeatButton>

                                        <!-- Thumb -->
                                        <Track.Thumb>
                                            <Thumb x:Name="Thumb"
                                                   Width="12" Height="12"
                                                   Background="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}"
                                                   BorderBrush="#494454"
                                                   BorderThickness="0"
                                                   />
                                        </Track.Thumb>

                                        <!-- Right/Increase button -->
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton x:Name="IncreaseRepeatButton" Command="Slider.IncreaseLarge"
                                                      Background="#C5C5C5"
                                                      BorderBrush="Gray"
                                                      BorderThickness="0"
                                                      Height="5"/>
                                        </Track.IncreaseRepeatButton>

                                    </Track>
                                    
                                </Grid>

                                <!-- TRIGGERS -->
                                <ControlTemplate.Triggers>
                                           
                                    <!-- Hover on Left Side -->
                                            <Trigger SourceName="DecreaseRepeatButton" Property="IsMouseOver" Value="True">
                                                <Setter Property="Cursor" Value="Hand"></Setter>
                                                <Setter TargetName="DecreaseRepeatButton" Property="Background" Value="{Binding CurrentTheme.WindowHeadingForeground.Brush}"></Setter>
                                            </Trigger>

                                    <!-- Hover on Thumb -->
                                    <Trigger SourceName="Thumb" Property="IsMouseOver" Value="True">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter TargetName="Thumb" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="Thumb" Property="Background" Value="{Binding CurrentTheme.WindowHeadingForeground.Brush}"/>
                                    </Trigger>

                                    <!-- Thumb pressed -->
                                    <Trigger SourceName="Thumb" Property="IsDragging" Value="True">
                                            <Setter TargetName="Thumb" Property="Background" Value="Gray"/>
                                    </Trigger>

                                    <!-- Disabled Slider -->
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="PART_Track" Property="Opacity" Value="0.5"/>
                                        <Setter TargetName="Thumb" Property="Opacity" Value="0.5"/>
                                    </Trigger>

                                            <!-- Hover on Right Side -->
                                            <Trigger SourceName="IncreaseRepeatButton" Property="IsMouseOver" Value="True">
                                                <Setter Property="Cursor" Value="Hand"></Setter>
                                            </Trigger>

                                        </ControlTemplate.Triggers>

                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>

                            <TextBlock x:Name="tbTrackEnd" Margin="10, 0, 0, 0" VerticalAlignment="Bottom" HorizontalAlignment="Right" Text="{Binding MusicPlayerCache.CurrentSong.Length, Converter={StaticResource DurationDisplayConverter}}" FontWeight="Regular" FontSize="11.3" Foreground="{Binding CurrentTheme.WindowHeadingForeground.Brush}"/>
                        
                    </StackPanel>
                    </Grid>
            </Border>
        </Grid>
        </Border>

        <!-- TitleBar -->

        <Border Name="bdrTitleBar" Background="{Binding CurrentTheme.TitleBarBackground.Brush}" PreviewMouseLeftButtonDown="bdrTitleBar_PreviewMouseLeftButtonDown" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" CornerRadius="10, 10, 0, 0">

                <Grid x:Name="grdTitleBar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Name="tbWindowTitle" Text="{Binding Path=WindowTitle}" 
                           Foreground="{Binding Path=CurrentTheme.WindowTitleForeground.Brush}" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Grid.Row="0" Grid.Column="1"/>
                    
                    <Border Name="borderWindowMove" Grid.Row="0" Grid.Column="1" Background="Transparent" MouseDown="borderWindowMove_MouseDown"/>

                    <StackPanel x:Name="spHeaderItems" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">

                        <Grid Name="grdSettings" VerticalAlignment="Stretch" 
                          MouseEnter="grdSettings_MouseEnter" MouseLeave="grdSettings_MouseLeave" 
                          MouseLeftButtonUp="grdSettings_MouseLeftButtonUp">
                            <TextBlock Name="tbSettings" Text="⚙" Foreground="White" Width="32" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Name="grdMinimize" VerticalAlignment="Stretch" 
                          MouseEnter="grdMinimize_MouseEnter" MouseLeave="grdMinimize_MouseLeave" 
                          MouseLeftButtonUp="grdMinimize_MouseLeftButtonUp">
                            <TextBlock Name="tbMinimize" Text="─" Foreground="White" Width="32" TextAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Name="grdResize" VerticalAlignment="Stretch" 
                          MouseEnter="grdResize_MouseEnter" MouseLeave="grdResize_MouseLeave" 
                          MouseLeftButtonUp="grdResize_MouseLeftButtonUp">
                            <TextBlock Name="tbResize" Text="🗗" Foreground="White" Width="32" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Name="grdClose" VerticalAlignment="Stretch"  
                          MouseEnter="grdClose_MouseEnter" MouseLeftButtonUp="grdClose_MouseLeftButtonUp" MouseLeave="grdClose_MouseLeave">
                            <TextBlock Name="tbClose" Text="✕" Foreground="White" Width="32" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Grid>
        </Border>

    </Grid>
    
</Window>
