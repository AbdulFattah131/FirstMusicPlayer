<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3" xmlns:convertor="clr-namespace:MusicPlayer.UIComponents.Convertor"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" MinWidth="800" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize"
        Closed="Window_Closed"
        d:DataContext="{d:DesignInstance local:MainWindowViewModel}"
        AllowsTransparency="True" Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Convertor -->
        <convertor:DurationToDisplayTimeConvertor x:Key="DurationDisplayConverter"/>
        <convertor:IndexConvertor x:Key="IndexConvertor"/>

        <!-- #region Filtered Albums -->
        <!-- Your Library View -->
        <CollectionViewSource x:Key="PopTagAlbums" Source="{Binding MusicPlayerCache.Albums}"/>
        <CollectionViewSource x:Key="FunkTagAlbums" Source="{Binding MusicPlayerCache.Albums}"/>
        <CollectionViewSource x:Key="RockTagAlbums" Source="{Binding MusicPlayerCache.Albums}"/>
        <CollectionViewSource x:Key="RnB/SoulTagAlbums" Source="{Binding MusicPlayerCache.Albums}"/>

        <!-- Explore View -->
        <CollectionViewSource x:Key="ContemporarySoulAlbums" Source="{Binding MusicPlayerCache.Albums}"/>
        <CollectionViewSource x:Key="ModernFunkHitsAlbums" Source="{Binding MusicPlayerCache.Albums}"/>
        <CollectionViewSource x:Key="HeavyRockAlbums" Source="{Binding MusicPlayerCache.Albums}"/>
        <CollectionViewSource x:Key="Proto-MetalClassicsAlbums" Source="{Binding MusicPlayerCache.Albums}"/>
        <CollectionViewSource x:Key="ProgressiveRockClassicsAlbums" Source="{Binding MusicPlayerCache.Albums}"/>
        <CollectionViewSource x:Key="ModernAlternative/IndieAlbums" Source="{Binding MusicPlayerCache.Albums}"/>
        <CollectionViewSource x:Key="Pop-CultureClassicsAlbums" Source="{Binding MusicPlayerCache.Albums}"/>
        <!-- #endregion -->
        
    </Window.Resources>
    
    <!-- Main Grid -->
    
    <Grid Name="grdMainWindow" Background="Transparent">

        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <!-- Title Bar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="130"/>
            <!-- Music Control Bar -->
        </Grid.RowDefinitions>

        <Border Name="bdrWindowContentBackground" Grid.ColumnSpan="3" Grid.RowSpan="3" 
                Background="{Binding CurrentTheme.WindowContentBackground.Brush}" 
                CornerRadius="15"/>

        <!-- Row 1 Grid -->
        
        <Grid Name="grdMainView" Grid.Row="1" Margin="10, 0, 10, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="295"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <!-- Column 0 Left Side Panel -->
            
            <DockPanel Name="dpLeftPanel" LastChildFill="True" Grid.Column="0" Grid.Row="1" Margin="20, 30, 15, 15">
                
                <StackPanel x:Name="ToggleGroup" DockPanel.Dock="Top">

                    <StackPanel x:Name="spLogo" Orientation="Horizontal">
                        <Path Data="M72 12 A24 24 0 0 0 48 36 V84 A24 24 0 0 0 72 108 H136 A48 48 0 0 0 136 12 H72 Z" Fill="{Binding CurrentTheme.WindowHeadingForeground.Brush}"  Margin="0, 0, -3, 0" Width="25" Height="25" Stretch="Uniform" VerticalAlignment="Center"/>
                        <TextBlock Text="sc" FontStyle="Normal" FontFamily="Lucida Handwriting" FontSize="13" Margin="-18, 4, 0, 5" Foreground="{Binding CurrentTheme.WindowPrimary.Brush}"></TextBlock>
                        <Path Data="M60 20 Q150 150, 60 280 H120 Q210 150, 120 20 Z" Fill="{Binding CurrentTheme.WindowHeadingForeground.Brush}"  Margin="0, 0, -8, 0" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"/>
                        <Path Data="M50 20 Q130 150, 50 280 H70 Q150 150, 70 20 Z" Fill="{Binding CurrentTheme.WindowHeadingForeground.Brush}"  Margin="0, 0, 0, 0" Width="15" Height="14.8" Stretch="Uniform" VerticalAlignment="Center"/>

                        <TextBlock Text="Spices &amp; Co" FontSize="18" FontFamily="Bahnschrift" FontWeight="Bold" Margin="1,0,0,0" VerticalAlignment="Center" Foreground="{Binding CurrentTheme.WindowHeadingForeground.Brush}"></TextBlock>
                    </StackPanel>

                    <TextBlock x:Name="tbHeading1" Text="Curation" Margin="0, 35, 0, 0" FontWeight="Bold" FontSize="15" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"></TextBlock>

                    <Border x:Name="bdrYourLibrary"> 
                        <Border.Effect>
                            <DropShadowEffect Color="#B0B8C0"
                              BlurRadius="2"
                              ShadowDepth="2"
                              Opacity="0.2"/>
                        </Border.Effect>
                        <ToggleButton x:Name="tbYourLibrary"
                          Height="40"
                          Width="180"
                          Margin="0,25,0,0"
                          Checked="ToggleButton_Checked"
                          FontSize="14"
                          BorderBrush="Transparent"
                          Foreground="Black">
                            
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="{Binding CurrentTheme.PlayerControlBackground.Brush}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        
                                        <ControlTemplate TargetType="ToggleButton">
                                            
                                            <Grid>
                                            <Border x:Name="border"
                                                CornerRadius="13"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}">
                                                <ContentPresenter Margin="25, 0, 0, 0" HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Content="{TemplateBinding Content}"/>
                                                </Border>
                                                    
                                                    <Path x:Name="pLibrary" Margin="25, 0, 10, 0" HorizontalAlignment="Left"
                                                     Data="M20,2H8A2,2 0 0,0 6,4V16A2,2 0 0,0 8,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2M20,16H8V4H20M12.5,15A2.5,2.5 0 0,0 15,12.5V7H18V5H14V10.5C13.58,10.19 13.07,10 12.5,10A2.5,2.5 0 0,0 10,12.5A2.5,2.5 0 0,0 12.5,15M4,6H2V20A2,2 0 0,0 4,22H18V20H4"
                                                     Fill="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}"
                                                     Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" /> 
                                                    <TextBlock x:Name="tbLibrary" Margin="50, 0, 0, 0" HorizontalAlignment="Left" Text="Your Library" VerticalAlignment="Center" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"/>
                                            </Grid>
                                            
                                                    <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background"
                                                      Value="{Binding CurrentTheme.LeftToggleHover.Brush}"/>
                                                    </Trigger>
                                                        
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pLibrary" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbLibrary" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                        
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pLibrary" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbLibrary" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                        
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    </Border>

                    <Border x:Name="bdrExplore">
                        <Border.Effect>
                            <DropShadowEffect Color="#B0B8C0"
                              BlurRadius="2"
                              ShadowDepth="2"
                              Opacity="0.2"/>
                        </Border.Effect>
                        <ToggleButton x:Name="tbExplore"
                      Height="40"
                      Width="180"
                      Checked="ToggleButton_Checked"
                      Margin="0,25,0,0"
                      FontSize="14"
                      BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                
                            </StackPanel>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{Binding CurrentTheme.PlayerControlBackground.Brush}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                    <Border x:Name="border"
                                                CornerRadius="13"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}">
                                                    <ContentPresenter Margin="25, 0, 0, 0" HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"/>
                                                </Border>
                                                <Path x:Name="pExplore" Margin="25, 0, 10, 0"
                                                    Data="M22 8V11H20V8H4V18H13.78C13.38 18.59 13.13 19.26 13.04 20H4C2.9 20 2 19.11 2 18V6C2 4.89 2.89 4 4 4H10L12 6H20C21.1 6 22 6.89 22 8M18.5 13V18.21C18.19 18.07 17.86 18 17.5 18C16.12 18 15 19.12 15 20.5S16.12 23 17.5 23 20 21.88 20 20.5V15H22V13H18.5Z"
                                                    Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Left"
                                                    Fill="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}"></Path>
                                                <TextBlock x:Name="tbExplore" Text="Explore" Margin="50, 0, 0, 0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background"
                                                        Value="{Binding CurrentTheme.LeftToggleHover.Brush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pExplore" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbExplore" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pExplore" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbExplore" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Border>

                    <TextBlock x:Name="tbHeading2" Text="My Music" Margin="0, 40, 0, 0" FontWeight="Bold" FontSize="15" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"></TextBlock>

                    <Border x:Name="bdrAlbums">
                        <Border.Effect>
                            <DropShadowEffect Color="#B0B8C0"
                              BlurRadius="2"
                              ShadowDepth="2"
                              Opacity="0.2"/>
                        </Border.Effect>
                        <ToggleButton x:Name="btnToggleAlbums"
                           Height="40"
                           Width="180"
                           Checked="ToggleButton_Checked"
                           Margin="0,25,0,0"
                           FontSize="14"
                           BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                
                            </StackPanel>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{Binding CurrentTheme.PlayerControlBackground.Brush}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                <Border x:Name="border"
                                             CornerRadius="13"
                                             Background="{TemplateBinding Background}"
                                             BorderBrush="{TemplateBinding BorderBrush}">
                                                    <ContentPresenter Margin="25, 0, 0, 0" HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Content="{TemplateBinding Content}"/>
                                                </Border>
                                                <Path x:Name="pAlbums" Margin="25, 0, 10, 0" Width="16.5" Height="16.5" Stretch="Uniform"
                                                  Fill="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}" HorizontalAlignment="Left"
                                                  Data="M22,4A2,2 0 0,1 24,6V16A2,2 0 0,1 22,18H6A2,2 0 0,1 4,16V4A2,2 0 0,1 6,2H12L14,4H22M2,6V20H20V22H2A2,2 0 0,1 0,20V11H0V6H2M6,6V16H22V6H6Z"/>
                                                    <TextBlock Margin="50, 0, 10, 0" HorizontalAlignment="Left" x:Name="tbAlbums" Text="Albums" VerticalAlignment="Center" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"/>
                                                </Grid>
                                                    <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background"
                                                     Value="{Binding CurrentTheme.LeftToggleHover.Brush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pAlbums" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbAlbums" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pAlbums" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbAlbums" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Border>

                    <Border x:Name="bdrSongs">
                        <Border.Effect>
                            <DropShadowEffect Color="#B0B8C0"
                          BlurRadius="2"
                          ShadowDepth="2"
                          Opacity="0.2"/>
                        </Border.Effect>
                        <ToggleButton x:Name="btnToggleSongs"
                           Height="40"
                           Width="180"
                           Checked="ToggleButton_Checked"
                           Margin="0,25,0,0"
                           FontSize="14"
                           BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">

                            </StackPanel>
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Background" Value="{Binding CurrentTheme.PlayerControlBackground.Brush}"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                    <Border x:Name="border"
                                                     CornerRadius="13"
                                                     Background="{TemplateBinding Background}"
                                                     BorderBrush="{TemplateBinding BorderBrush}">
                                                        <ContentPresenter Margin="25, 0, 0, 0" HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Content="{TemplateBinding Content}"/>
                                                    </Border>
                                                    <Path x:Name="pSongs" Margin="25, 0, 10, 0" Width="15" Height="15" Stretch="Uniform"
                                                          Fill="{Binding CurrentTheme.WindowPrimaryAnchor.Brush}" HorizontalAlignment="Left"
                                                          Data="M21,3V15.5A3.5,3.5 0 0,1 17.5,19A3.5,3.5 0 0,1 14,15.5A3.5,3.5 0 0,1 17.5,12C18.04,12 18.55,12.12 19,12.34V6.47L9,8.6V17.5A3.5,3.5 0 0,1 5.5,21A3.5,3.5 0 0,1 2,17.5A3.5,3.5 0 0,1 5.5,14C6.04,14 6.55,14.12 7,14.34V6L21,3Z"/>            
                                                    <TextBlock Margin="50, 0, 10, 0" HorizontalAlignment="Left" x:Name="tbSongs" Text="Songs" VerticalAlignment="Center" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background"
                                                        Value="{Binding CurrentTheme.LeftToggleHover.Brush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pSongs" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbSongs" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                        <Setter TargetName="pSongs" Property="Fill" Value="White"/>
                                                        <Setter TargetName="tbSongs" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Border>

                </StackPanel>

                <Border x:Name="bdrNewPlaylist">
                    <Border.Effect>
                        <DropShadowEffect Color="#B0B8C0"
                           BlurRadius="2"
                           ShadowDepth="2"
                           Opacity="0.4"/>
                    </Border.Effect>
                    <ToggleButton x:Name="NewPlaylist"
                       MouseLeftButtonUp="NewPlaylist_MouseLeftButtonUp"
                       Height="35"
                       Margin="0,25,0,0"
                       BorderBrush="Transparent"
                       VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            
                        </StackPanel>
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="{Binding CurrentTheme.WindowPrimary.Brush}"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="FontWeight" Value="Regular"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid>
                                                <Border x:Name="border"
                                                     CornerRadius="13"
                                                     Background="{TemplateBinding Background}"
                                                     BorderBrush="{TemplateBinding BorderBrush}">   
                                                    <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Content="{TemplateBinding Content}"/>
                                            </Border>
                                                <StackPanel x:Name="spNewPlaylist" Margin="-5, 0, 0, 0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path x:Name="pNewPlaylist" Margin="0, 3, 0, 0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                Data ="M3 16H10V14H3M18 14V10H16V14H12V16H16V20H18V16H22V14M14 6H3V8H14M14 10H3V12H14V10Z"
                                                Fill="#1e1e1e" Stretch="Uniform"
                                                Width="16" Height="16"/>
                                            <TextBlock x:Name="tbNewPlaylist" Margin="10, 0, 0, 0" HorizontalAlignment="Left" Text="New Playlist" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background"
                                                  Value="{Binding CurrentTheme.LeftToggleHover.Brush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Setter TargetName="pNewPlaylist" Property="Fill"
                                                        Value="White"/>
                                                    <Setter TargetName="tbNewPlaylist" Property="Foreground"
                                                        Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="{Binding CurrentTheme.LeftToggleSelected.Brush}"/>
                                                    <Setter TargetName="pNewPlaylist" Property="Fill" Value="White"/>
                                                    <Setter TargetName="tbNewPlaylist" Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </Border>
            </DockPanel>
            
            <!-- Column 2 Right Side Panel -->
            
            <ScrollViewer x:Name="svRightSidePanel" Grid.Column="2" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0, 0, 0, 15">
                <Grid x:Name="grdRightPanel">

                    <StackPanel Orientation="Vertical" VerticalAlignment="Top" Margin="15, 10, 25, 0">
                    
                    <!--Genres-->
                    <Border Height="150" CornerRadius="15" Background="{Binding CurrentTheme.PlayerControlBackground.Brush}">
                        <Border.Effect>
                            <DropShadowEffect Color="#B0B8C0"
                              BlurRadius="0"
                              Direction="270"
                              ShadowDepth="3"
                              Opacity="0.2"/>
                        </Border.Effect>
                        <StackPanel Orientation="Vertical" Margin="15,17,15,0">
                            <TextBlock Text="Genres" FontSize="13" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}" FontWeight="Bold"/>
                            <ItemsControl ItemsSource="{Binding MusicPlayerCache.SelectedAlbum.Genres}" Margin="0,20,0,0">
                                <ItemsControl.ItemsPanel> <!--Pop, Funk, Disco-->
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,15,15" Padding="8" CornerRadius="8" Background="{Binding DataContext.CurrentTheme.WindowPrimary.Brush, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <TextBlock Text="{Binding}" FontSize="12.4" FontFamily="Bahnschrift" FontWeight="Bold" Foreground="{Binding DataContext.CurrentTheme.GenresTextForeground.Brush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    
                    <!--Lyrics-->
                    <Border x:Name="bdrLyrics" Height="300" CornerRadius="15" Background="{Binding CurrentTheme.PlayerControlBackground.Brush}" Margin="0,25,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#B0B8C0"
                              Direction="270"
                              BlurRadius="0"
                              ShadowDepth="3"
                              Opacity="0.2"/>
                        </Border.Effect>
                        <StackPanel x:Name="spLyrics" Orientation="Vertical" Margin="15,0,0,0">
                            <TextBlock Text="Lyrics" FontWeight="Bold" Margin="0, 12, 0, 0" FontSize="14" Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"/>

                            <ScrollViewer Margin ="0, 10, 10, 10" Height="250" VerticalScrollBarVisibility="Visible" PreviewMouseWheel="PreviewMouseWheel" >
                                

                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ScrollViewer">
                                                        <Grid x:Name="Root" Background="Transparent">
                                                            <!-- Scroll content -->
                                                            <ScrollContentPresenter />

                                                            <!-- Custom vertical scrollbar -->
                                                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Orientation="Vertical"
                                       Width="8"
                                       Margin="0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       Background="Transparent"
                                       Visibility="Collapsed"
                                       Minimum="0"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       SmallChange="16"
                                       LargeChange="64">
                                                                <ScrollBar.Style>
                                                                    <Style TargetType="ScrollBar">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="ScrollBar">
                                                                                    <Grid x:Name="ScrollRoot" Background="Transparent" Width="8">
                                                                                        <Track x:Name="PART_Track" IsDirectionReversed="True">

                                                                                            <!-- Hidden arrow buttons -->
                                                                                            <Track.DecreaseRepeatButton>
                                                                                                <RepeatButton Command="ScrollBar.LineUpCommand"
                                                                              Height="10"
                                                                              Visibility="Hidden"
                                                                              Background="Transparent"
                                                                              Focusable="False"
                                                                              BorderThickness="0"/>
                                                                                            </Track.DecreaseRepeatButton>

                                                                                            <!-- Rounded thumb -->
                                                                                            <Track.Thumb>
                                                                                                <Thumb x:Name="Thumb" Visibility="Collapsed">
                                                                                                    <Thumb.Template>
                                                                                                        <ControlTemplate TargetType="Thumb">
                                                                                                            <Border Background="#c0c0c0"
                                                                                    CornerRadius="4"
                                                                                    SnapsToDevicePixels="True"/>
                                                                                                        </ControlTemplate>
                                                                                                    </Thumb.Template>
                                                                                                </Thumb>
                                                                                            </Track.Thumb>

                                                                                            <Track.IncreaseRepeatButton>
                                                                                                <RepeatButton Command="ScrollBar.LineDownCommand"
                                                                              Height="10"
                                                                              Visibility="Hidden"
                                                                              Background="Transparent"
                                                                              Focusable="False"
                                                                              BorderThickness="0"/>
                                                                                            </Track.IncreaseRepeatButton>
                                                                                        </Track>
                                                                                    </Grid>

                                                                                    <!-- Hover logic -->
                                                                                    <ControlTemplate.Triggers>
                                                                                        <!-- Show thumb when scrollbar hovered -->
                                                                                        <Trigger Property="IsMouseOver" Value="True">
