<Window x:Class="MusicPlayer.UIComponents.PlaylistsWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:MusicPlayer.UIComponents"
        mc:Ignorable="d"
        Title="PlaylistsWindow" Height="500" Width="1000"
        WindowStyle="None" ResizeMode="NoResize"
        Closed="Window_Closed"
        AllowsTransparency="True" Background="Transparent">

    <Grid Name="grdPlaylistsWindow" Background="Transparent">
        
        <Grid.RowDefinitions>
            
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>
        
       
        <!-- Title Bar -->
        <Grid Grid.Row="0" Height="32" Margin="8,4,8,0">
            <TextBlock Text="Playlists"
                       FontFamily="Bahnschrift"
                       FontWeight="Bold"
                       FontSize="15"
                       VerticalAlignment="Center"
                       Foreground="Blue"/>
        </Grid>
        
        <!-- Background Border -->
        <Border Grid.RowSpan="2" Grid.ColumnSpan="1"
         Background="Gray"
         CornerRadius="15"
         Margin="0">
            <Border.Effect>
                <DropShadowEffect Color="Black"
              Direction="270"
              ShadowDepth="10"
              Opacity="1"
              BlurRadius="0"/>
            </Border.Effect>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="15,10,15,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <!-- Left: Playlist List -->
            <Border Grid.Column="0"
                    CornerRadius="12"
                    Background="{Binding CurrentTheme.PlayerControlBackground.Brush}"
                    Margin="0,0,10,0"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="Your Playlists"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"
                               Margin="0,0,0,10"/>
                    <!-- Placeholder playlist items -->
                    <ItemsControl ItemsSource="{Binding Playlists}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding DataContext.CurrentTheme.LeftToggleHover.Brush, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CornerRadius="8"
                                        Margin="0,5,0,0"
                                        Padding="8">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{Binding DataContext.CurrentTheme.WindowTextForeground.Brush, RelativeSource={RelativeSource AncestorType=Window}}"
                                               FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- Right: Playlist Detail Preview -->
            <Border Grid.Column="1"
                    CornerRadius="12"
                    Background="{Binding CurrentTheme.PlayerControlBackground.Brush}"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding SelectedPlaylist.Name}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"/>
                    <TextBlock Grid.Row="1"
                               Text="Select a playlist to view details"
                               FontSize="13"
                               Foreground="{Binding CurrentTheme.WindowTextForeground.Brush}"
                               Margin="0,10,0,0"/>
                </Grid>
            </Border>
        </Grid>
        
    </Grid>
    
</Window>
